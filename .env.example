# Infosys Portal - Environment Variables Example

# Node environment
NODE_ENV=development

# Session secret (use a strong random secret in production)
SESSION_SECRET=your-super-secret-key-change-this-in-production

# Server port
PORT=3000

# HTTPS settings (optional - server falls back to HTTP if certs are not present)
# Set HTTPS_ENABLED=true and provide cert paths to enable HTTPS
HTTPS_ENABLED=false
# HTTPS_KEY=/path/to/private-key.pem
# HTTPS_CERT=/path/to/certificate.crt

# PostgreSQL database settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kst_portal
DB_USER=chitti
DB_PASSWORD=examplepassword
