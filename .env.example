# Infosys Portal - Environment Variables Example

# Node environment
NODE_ENV=development

# Session secret (use a strong random secret in production)
SESSION_SECRET=your-super-secret-key-change-this-in-production

# Server port
PORT=3000

# PostgreSQL credentials
POSTGRES_USER=your_db_user_here
POSTGRES_PASSWORD=change-this-password-in-production
POSTGRES_DB=kst_portal
